<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GearHotkeys</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Change this to your Nuclear Option install folder -->
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
    <Managed>$(GameDir)\NuclearOption_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll" />
    <Reference Include="$(Managed)\Assembly-CSharp.dll" />
    <Reference Include="$(Managed)\Rewired_Core.dll" />
    <Reference Include="$(Managed)\Mirage.dll" />
    <Reference Include="$(Managed)\UnityEngine.dll" />
    <Reference Include="$(Managed)\UnityEngine.CoreModule.dll" />
    <Reference Include="$(Managed)\UnityEngine.IMGUIModule.dll" />
  </ItemGroup>

</Project>
